{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    //"ignoreDeprecations": "6.0",
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true
  }
}